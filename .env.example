DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
RIOT_API_KEY=your_riot_api_key_here

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=your_mysql_database_name
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password

# Optional:
# PORT=3000
# MYSQL_SSL=false
# MYSQL_SSL_CA=/path/to/ca.pem

# VALORANT (HenrikDev API key)
VALORANT_API_KEY=your_henrikdev_api_key

# --- New features ---------------------------------------------------------
# One channel for rank-ups, match recaps, live games, the weekly LP race and
# welcome messages. Each can be moved to its own channel with the vars below.
# Defaults to 1545132839522017284 (the server's announcement channel).
# ANNOUNCEMENTS_CHANNEL_ID=
# RANK_UP_CHANNEL_ID=
# MATCH_RECAP_CHANNEL_ID=
# LIVE_GAMES_CHANNEL_ID=
# LP_RACE_CHANNEL_ID=
# WELCOME_CHANNEL_ID=

# Welcome messages + instant cleanup when someone leaves. FIRST enable
# "Server Members Intent" in the Discord Developer Portal (Bot tab), or login fails.
# ENABLE_MEMBER_EVENTS=true

# Optional tuning
# CLIMBER_ROLE_ID=              # existing "Climber of the Week" role (created automatically if missing)
# LP_RACE_POST_HOUR_UTC=10      # Monday hour (UTC) the weekly race is posted
# RIOT_MIN_GAP_MS=1250          # lower only with a Riot production key
# HENRIK_MIN_GAP_MS=2100        # lower only with a higher-tier HenrikDev key
